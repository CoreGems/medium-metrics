<Window x:Class="MediumMetrics.Views.StoryStatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:MediumMetrics.Views"
        Title="Story stats" Height="620" Width="600"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <conv:RatioToPercentConverter x:Key="Ratio" />
        <Style TargetType="TextBlock" x:Key="Big">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#777" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <!-- Header -->
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Foreground="#777" FontSize="12">
                    <Run Text="Published " /><Run Text="{Binding PublishedAt.LocalDateTime, StringFormat=yyyy-MM-dd, Mode=OneWay}" />
                </TextBlock>
                <Button Content="Open in browser" Click="OnOpenClick" Padding="8,2" Margin="12,0,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- Bottom buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock x:Name="DetailStatus" Foreground="#777" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button x:Name="RefreshButton" Content="Refresh details" Click="OnRefreshClick" Padding="12,6" Margin="0,0,8,0" />
            <Button Content="Close" Click="OnCloseClick" Padding="16,6" />
        </StackPanel>

        <StackPanel>
            <!-- Headline tiles (from the dashboard query, already loaded) -->
            <UniformGrid Rows="1" Columns="3" Margin="0,18,0,0">
                <StackPanel><TextBlock Text="{Binding Views}" Style="{StaticResource Big}" /><TextBlock Text="Views" Style="{StaticResource Label}" /></StackPanel>
                <StackPanel><TextBlock Text="{Binding Reads}" Style="{StaticResource Big}" /><TextBlock Text="Reads" Style="{StaticResource Label}" /></StackPanel>
                <StackPanel><TextBlock Text="{Binding ReadRatio, Converter={StaticResource Ratio}}" Style="{StaticResource Big}" /><TextBlock Text="Read ratio" Style="{StaticResource Label}" /></StackPanel>
            </UniformGrid>
            <UniformGrid Rows="1" Columns="3" Margin="0,16,0,0">
                <StackPanel><TextBlock Text="{Binding Impressions}" Style="{StaticResource Big}" /><TextBlock Text="Impressions" Style="{StaticResource Label}" /></StackPanel>
                <StackPanel><TextBlock Text="{Binding Claps}" Style="{StaticResource Big}" /><TextBlock Text="Claps" Style="{StaticResource Label}" /></StackPanel>
                <StackPanel><TextBlock Text="{Binding EarningsUsd, StringFormat=C2}" Style="{StaticResource Big}" /><TextBlock Text="Earnings" Style="{StaticResource Label}" /></StackPanel>
            </UniformGrid>

            <!-- Impact (loaded on demand) -->
            <Separator Margin="0,18,0,8" />
            <TextBlock Text="Impact" FontWeight="SemiBold" Margin="0,0,0,8" />
            <UniformGrid Rows="1" Columns="3">
                <StackPanel><TextBlock x:Name="FollowersText" Text="—" Style="{StaticResource Big}" /><TextBlock Text="Followers gained (net)" Style="{StaticResource Label}" /></StackPanel>
                <StackPanel><TextBlock x:Name="SubscribersText" Text="—" Style="{StaticResource Big}" /><TextBlock Text="Subscribers gained (net)" Style="{StaticResource Label}" /></StackPanel>
                <StackPanel><TextBlock x:Name="CtrText" Text="—" Style="{StaticResource Big}" /><TextBlock Text="Feed click-through" Style="{StaticResource Label}" /></StackPanel>
            </UniformGrid>

            <!-- Referrers (loaded on demand) -->
            <Separator Margin="0,18,0,8" />
            <TextBlock Text="Traffic sources" FontWeight="SemiBold" Margin="0,0,0,8" />
            <DataGrid x:Name="ReferrersGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False"
                      MaxHeight="180">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="*" />
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120" />
                    <DataGridTextColumn Header="Views" Binding="{Binding Count}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </DockPanel>
</Window>
