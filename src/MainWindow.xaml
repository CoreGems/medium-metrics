<Window x:Class="MediumMetrics.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Medium Metrics" Height="640" Width="900"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Header: shell chrome only — everything platform-specific (accounts,
             sign-in, refresh, reports) lives in the hosted page. -->
        <Border DockPanel.Dock="Top" Background="#1A1A1A" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Medium Metrics" FontSize="18" FontWeight="Bold" Foreground="White"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Settings" Click="OnSettingsClick" Padding="10,6"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Active page. Today always the Medium dashboard; the host exists so the
             window can grow into a shell with more pages (Overview, other platforms). -->
        <ContentControl x:Name="DashboardHost" Focusable="False" />
    </DockPanel>
</Window>
